{
  "name": "marketing-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "engine": "node src/server/cli.ts",
    "lint": "eslint src --max-warnings 0 --no-error-on-unmatched-pattern",
    "check:imports": "node tools/check-imports.mjs",
    "feature-map": "node tools/feature-map.mjs",
    "check": "npm run lint && npm run check:imports && tsc --noEmit && npm run feature-map -- --check && node --test tools/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "10.9.1",
    "typescript": "5.9.3"
  }
}
